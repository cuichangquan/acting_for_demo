<h1>Executed Purchases</h1><p>Direct human purchases and delegated-agent purchases that received <strong>ALLOW</strong> appear here.</p>
<div class="table-wrap"><table><thead><tr><th>Timestamp</th><th>Actor / Source</th><th>Principal</th><th>Product</th><th>Amount</th></tr></thead><tbody>
<% @purchases.each do |purchase| %><tr><td><%= purchase.created_at.to_fs(:long) %></td><td><span class="badge"><%= purchase.source.tr("_", " ").upcase %></span></td><td><%= purchase.user.name %></td><td><%= purchase.product.name %></td><td><%= number_to_currency(purchase.amount, unit: "¥", precision: 0) %></td></tr><% end %>
</tbody></table></div><p class="empty"><%= "No purchases executed yet." if @purchases.empty? %></p>
